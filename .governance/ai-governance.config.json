{
  "canonical": {
    "path": "agents.md",
    "requiredKeywords": [
      "MUST",
      "SHOULD",
      "LEGACY EXCEPTIONS",
      "FOR NEW FEATURES"
    ]
  },
  "warnings": {
    "maxExamplesPerCategory": 5
  },
  "adapters": [
    {
      "path": ".github/copilot-instructions.md",
      "kind": "copilot"
    },
    {
      "path": ".cursor/rules/cheffia-front-agents.mdc",
      "kind": "cursor"
    },
    {
      "path": "CLAUDE.md",
      "kind": "claude"
    },
    {
      "path": "AGENTS.md",
      "kind": "codex"
    }
  ],
  "legacyExceptions": {
    "directInfraInV1RouteAllowlist": [],
    "frontendFeatureStructureAllowlist": [
      "app",
      "app/(auth-pages)/forgot-password",
      "app/(auth-pages)/resend-confirmation",
      "app/(auth-pages)/set-password",
      "app/(auth-pages)/sign-in",
      "app/(auth-pages)/sign-up",
      "app/backoffice/(portal)",
      "app/backoffice/(portal)/dashboard",
      "app/backoffice/(portal)/restaurants",
      "app/backoffice/(portal)/restaurants/[restaurantId]",
      "app/backoffice/(portal)/users",
      "app/backoffice/sign-in",
      "app/dashboard",
      "app/error",
      "app/order/checkout",
      "app/order/checkout/success",
      "app/register/profile",
      "app/register/restaurant",
      "app/restaurant/account",
      "app/restaurant/menu/[slug]",
      "app/restaurant/menu/[slug]/edit",
      "app/restaurant/menu/[slug]/qrcode",
      "app/restaurant/order-hub/[slug]",
      "app/unauthorized"
    ],
    "nonTypeScriptFileAllowlist": [
      "eslint.config.mjs",
      "postcss.config.mjs",
      "scripts/check-prisma-env.mjs",
      "scripts/print-ngrok-webhook-url.mjs",
      "scripts/validate-ngrok-webhook.mjs",
      "tests/migration/contracts.openapi.test.mjs",
      "tests/migration/runtime.e2e.test.mjs"
    ]
  }
}
