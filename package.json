{
  "name": "cheffia-front-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_ENV=development next dev",
    "prebuild": "bun run prisma:generate",
    "build": "next build",
    "start": "next start",
    "test": "bun test tests/ci tests/unit tests/integration tests/regressions",
    "test:components": "vitest run --config vitest.config.mts",
    "test:components:watch": "vitest --config vitest.config.mts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:local": "bun scripts/e2e-local.mjs",
    "test:backend:coverage": "bun test tests/ci tests/unit tests/integration tests/regressions --coverage --coverage-reporter=lcov --coverage-dir=coverage/backend",
    "test:frontend:coverage": "vitest run --config vitest.config.mts --coverage",
    "test:e2e:coverage": "PLAYWRIGHT_JSON_REPORT=coverage/e2e/results.json playwright test --config=playwright.config.ts",
    "test:e2e:coverage:local": "PLAYWRIGHT_JSON_REPORT=coverage/e2e/results.json bun scripts/e2e-local.mjs",
    "coverage:gate": "bun scripts/coverage-gate.mjs --backend=coverage/backend/lcov.info --frontend=coverage/frontend/coverage-summary.json --e2e=coverage/e2e/results.json --threshold=90",
    "test:coverage": "bun run test:backend:coverage && bun run test:frontend:coverage && bun run test:e2e:coverage:local && bun run coverage:gate",
    "pretypecheck": "bun run prisma:generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "supabase:migrate:push": "supabase db push --linked",
    "db:reset": "bun scripts/db-reset.mjs",
    "db:verify": "bun scripts/verify-foundation.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/material": "^6.4.11",
    "@next/env": "^15.3.1",
    "@nextui-org/react": "^2.6.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.8",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-radio-group": "^1.3.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slider": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@types/socket.io": "^3.0.2",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "motion": "^11.18.2",
    "next": "15.1.11",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.1",
    "react-icons": "^5.5.0",
    "react-to-print": "^3.0.6",
    "shadcn": "^2.4.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.3",
    "stripe": "^18.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.64.1",
    "@stripe/react-stripe-js": "^3.6.0",
    "@stripe/stripe-js": "^7.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.4.21",
    "bun-types": "^1.4.3",
    "cross-env": "^7.0.3",
    "dotenv": "18.0.8",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "jsdom": "29.1.1",
    "postcss": "^8.5.3",
    "prisma": "7.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
