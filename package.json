{
  "name": "cheffia-front-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_OPTIONS='--inspect' NODE_ENV=development next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "governance:sync": "bun scripts/ai-governance.ts sync-adapters",
    "governance:check": "bun scripts/ai-governance.ts check",
    "governance:warn-allowlist": "bun scripts/ai-governance.ts warn-allowlist",
    "lint": "next lint && bun run landing:check && bun run ui:check",
    "landing:check": "bun scripts/check-landing-regression.ts",
    "ui:check": "bun scripts/check-ui-feedback-regression.ts",
    "typecheck": "tsc --noEmit",
    "test:migration": "bun test tests/migration",
    "test:migration:strict": "cross-env MIGRATION_E2E_REQUIRED=1 bun test tests/migration",
    "migration:baseline": "bun run typecheck && bun run lint && bun run test:migration && bun run artifacts:check && bun run prisma:env:check",
    "migration:baseline:full": "bun run migration:baseline && bun run prisma:gate && bun run build",
    "migration:baseline:strict": "bun run migration:baseline:full && bun run test:migration:strict",
    "ngrok": "ngrok http --domain=nonzero-rodrick-mentholated.ngrok-free.dev 3000",
    "ngrok:webhook": "ngrok http 3000",
    "ngrok:webhook:url": "node scripts/print-ngrok-webhook-url.mjs",
    "ngrok:webhook:check": "node scripts/validate-ngrok-webhook.mjs",
    "webhook:local:url": "node scripts/print-ngrok-webhook-url.mjs --path /api/v1/cheffia/OrderHub/webhook/asaas",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "collections:generate": "bun scripts/generate-openapi.ts",
    "artifacts:check": "bun run openapi:generate && git diff --exit-code -- app/api/openapi/openapi.json postman insomnia",
    "prisma:env:check": "node scripts/check-prisma-env.mjs",
    "prisma:gate": "bun run prisma:env:check && bun run prisma:validate",
    "prisma:validate": "bunx prisma@6.16.3 validate",
    "prisma:format": "bunx prisma@6.16.3 format",
    "prisma:generate": "bunx prisma@6.16.3 generate",
    "prisma:migrate": "bunx prisma@6.16.3 migrate dev",
    "prisma:migrate:deploy": "bunx prisma@6.16.3 migrate deploy",
    "prisma:migrate:status": "bunx prisma@6.16.3 migrate status",
    "prisma:studio": "bunx prisma@6.16.3 studio",
    "prisma:erd": "bunx prisma@6.16.3 generate --generator erd"
  },
  "dependencies": {    "@hookform/resolvers": "^5.2.1",    "@next/env": "^15.3.1",
    "@nextui-org/react": "^2.6.11",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^6.16.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-radio-group": "^1.3.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.57.2",
    "@types/socket.io": "^3.0.2",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.34.3",
    "next": "15.5.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.1",
    "react-icons": "^5.5.0",
    "react-to-print": "^3.0.6",
    "resend": "^6.9.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@next/eslint-plugin-next": "^16.1.6",
    "@eslint/eslintrc": "^3.3.1",
    "@types/jszip": "^3.4.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^10.0.3",
    "eslint-config-next": "^15.3.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.16.3",
    "prisma-erd-generator": "^2.0.4",
    "shadcn": "^4.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5",
    "typescript-eslint": "^8.43.0"
  }
}





